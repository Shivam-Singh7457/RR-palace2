# AI Service Configuration
ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# LLM Configuration
# Options for LLM_PROVIDER: mock, gemini, openai
LLM_PROVIDER=mock
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Backend Service URL (For Node.js MERN Backend)
NODE_BACKEND_URL=http://localhost:5000

# MongoDB Connection (Atlas Vector Search & Database)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
MONGODB_DB_NAME=rr_palace

